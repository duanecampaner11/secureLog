@model DashboardViewModel

@{
    ViewData["Title"] = "Guest Dashboard";
}

<div class="container">
    <h2>Guest Entry Dashboard</h2>
    
    <!-- ADD GUEST FORM -->
    <div class="card mb-4">
        <div class="card-header">
            <h4>Add New Visitor</h4>
        </div>
        <div class="card-body">
            <form asp-action="Add" method="post">
                @Html.AntiForgeryToken()
                <div class="row">
                    <div class="col-md-5">
                        <input asp-for="NewGuest.Name" class="form-control" placeholder="Visitor Name" required />
                    </div>
                    <div class="col-md-5">
                        <input asp-for="NewGuest.Purpose" class="form-control" placeholder="Purpose" required />
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary w-100">Add Visitor</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
    
    <!-- SEARCH FORM -->
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" asp-action="Index">
                <div class="row">
                    <div class="col-md-10">
                        <input type="text" name="search" class="form-control" placeholder="Search by name or date (YYYY-MM-DD)" value="@Model.Search" />
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-secondary w-100">Search</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
    
    <!-- GUEST ENTRIES TABLE -->
    <div class="card">
        <div class="card-header">
            <h4>Guest Entries</h4>
        </div>
        <div class="card-body">
            @if (!Model.Entries.Any())
            {
                <p>No entries found.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Purpose</th>
                                <th>Time In</th>
                                <th>Time Out</th>
                                <th>Logged By</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in Model.Entries)
                            {
                                <tr>
                                    <td>@entry.Name</td>
                                    <td>@entry.Purpose</td>
                                    <td>@entry.TimeIn.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>@(entry.TimeOut?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                                    <td>@(Model.UserNames.TryGetValue(entry.LoggedByUserId, out var name) ? name : "—")</td>
                                    <td>
                                        @if (entry.TimeOut == null)
                                        {
                                            <form asp-action="TimeOut" method="post" style="display:inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@entry.Id" />
                                                <button type="submit" class="btn btn-sm btn-warning">Time Out</button>
                                            </form>
                                        }
                                        <form asp-action="Delete" method="post" style="display:inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@entry.Id" />
                                            <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Delete this entry?')">Delete</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>