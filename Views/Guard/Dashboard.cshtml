@model List<VisitRequest>

@{
    ViewData["Title"] = "Guard Dashboard";
}

<h2>Guard Dashboard</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="row">
    <div class="col-md-4">
        <div class="card">
            <div class="card-header bg-info">
                <h4>Verify Visitor</h4>
            </div>
            <div class="card-body">
                <form method="post" asp-action="VerifyVisitor">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label">Confirmation ID</label>
                        <input type="text" name="confirmationId" class="form-control" required />
                    </div>
                    <button type="submit" class="btn btn-primary">Verify</button>
                </form>
            </div>
        </div>
    </div>
    
    <div class="col-md-8">
        <div class="card">
            <div class="card-header bg-success">
                <h4>Today's Visits</h4>
            </div>
            <div class="card-body">
                @if (!Model.Any())
                {
                    <p>No confirmed visits for today.</p>
                }
                else
                {
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Confirmation ID</th>
                                <th>Name</th>
                                <th>Company</th>
                                <th>Purpose</th>
                                <th>Time</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var v in Model)
                            {
                                <tr>
                                    <td>@v.ConfirmationId</td>
                                    <td>@v.FullName</td>
                                    <td>@v.Company</td>
                                    <td>@v.Purpose</td>
                                    <td>@(v.VisitTime.HasValue ? v.VisitTime.Value.ToString("hh:mm tt") : "Not set")</td>
                                    <td>@v.Status</td>
                                    <td>
                                        @if (v.Status == RequestStatus.Confirmed)
                                        {
                                            <form method="post" asp-action="CheckIn" style="display:inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@v.Id" />
                                                <button type="submit" class="btn btn-sm btn-primary">Check In</button>
                                            </form>
                                        }
                                        else if (v.Status == RequestStatus.CheckedIn)
                                        {
                                            <form method="post" asp-action="CheckOut" style="display:inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@v.Id" />
                                                <button type="submit" class="btn btn-sm btn-secondary">Check Out</button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>