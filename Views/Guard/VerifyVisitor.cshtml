@model VisitRequest

@{
    ViewData["Title"] = "Verify Visitor";
}

<h2>Verify Visitor</h2>

<form method="post">
    @Html.AntiForgeryToken()
    <div class="mb-3">
        <label class="form-label">Confirmation ID</label>
        <input type="text" name="confirmationId" class="form-control" required />
    </div>
    <button type="submit" class="btn btn-primary">Verify</button>
</form>

@if (ViewBag.IsValid == true && ViewBag.Visit != null)
{
    <div class="alert alert-success mt-4">
        <h4>VALID VISITOR</h4>
        <p><strong>Name:</strong> @ViewBag.Visit.FullName</p>
        <p><strong>Company:</strong> @ViewBag.Visit.Company</p>
        <p><strong>Purpose:</strong> @ViewBag.Visit.Purpose</p>
        <p><strong>Meeting:</strong> @ViewBag.Visit.PersonToMeet</p>
        <form method="post" action="/Guard/CheckIn">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@ViewBag.Visit.Id" />
            <button type="submit" class="btn btn-success">Check In Now</button>
        </form>
    </div>
}
else if (ViewBag.IsValid == false)
{
    <div class="alert alert-danger mt-4">
        <h4>INVALID</h4>
        <p>@ViewBag.Error</p>
    </div>
}