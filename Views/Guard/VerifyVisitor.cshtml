@model VisitRequest

<h2>Verify Visitor</h2>

<form method=""post"">
    @Html.AntiForgeryToken()
    <input type=""text"" name=""confirmationId"" class=""form-control"" placeholder=""Confirmation ID"" required />
    <button type=""submit"" class=""btn btn-primary mt-2"">Verify</button>
</form>

@if (ViewBag.IsValid == true && ViewBag.Visit != null)
{
    <div class=""alert alert-success mt-4"">
        <h4>VALID VISITOR</h4>
        <p>Name: @ViewBag.Visit.FullName</p>
        <p>Company: @ViewBag.Visit.Company</p>
        <p>Purpose: @ViewBag.Visit.Purpose</p>
        <p>Meeting: @ViewBag.Visit.PersonToMeet</p>
        <form method=""post"" action=""/Guard/CheckIn"">
            @Html.AntiForgeryToken()
            <input type=""hidden"" name=""id"" value=""@ViewBag.Visit.Id"" />
            <button type=""submit"" class=""btn btn-success"">Check In</button>
        </form>
    </div>
}
else if (ViewBag.IsValid == false)
{
    <div class=""alert alert-danger mt-4"">
        <h4>INVALID</h4>
        <p>@ViewBag.Error</p>
    </div>
}
