@model List<VisitRequest>
@{ ViewData["Title"] = "Guard Dashboard"; }

<h2>Guard Dashboard</h2>

@if (TempData["Error"] != null) { <div>Error: @TempData["Error"]</div> }
@if (TempData["Success"] != null) { <div>Success: @TempData["Success"]</div> }

<h3>Verify Visitor</h3>
<form method="post" asp-action="VerifyVisitor">
    @Html.AntiForgeryToken()
    <label>Confirmation ID:</label>
    <input type="text" name="confirmationId" required />
    <button type="submit">Verify</button>
</form>

<hr />

<h3>Confirmed Visits</h3>

@if (!Model.Any())
{
    <p>No confirmed visits.</p>
}
else
{
    <table>
        <thead>
            <tr><th>ID</th><th>Name</th><th>Company</th><th>Purpose</th><th>Date</th><th>Status</th><th>Action</th></tr>
        </thead>
        <tbody>
            @foreach (var visit in Model)
            {
                <tr>
                    <td>@visit.ConfirmationId</strong></td>
                    <td>@visit.FullName</strong></td>
                    <td>@visit.Company</strong></td>
                    <td>@visit.Purpose</strong></td>
                    <td>@visit.VisitDate.ToString("yyyy-MM-dd")</strong></td>
                    <td>@visit.Status</strong></td>
                    <td>
                        @if (visit.Status == RequestStatus.Confirmed)
                        {
                            <form method="post" asp-action="CheckIn" style="display:inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@visit.Id" />
                                <button type="submit">Check In</button>
                            </form>
                        }
                        else if (visit.Status == RequestStatus.CheckedIn)
                        {
                            <form method="post" asp-action="CheckOut" style="display:inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@visit.Id" />
                                <button type="submit">Check Out</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
