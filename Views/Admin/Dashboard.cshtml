@model List<VisitRequest>

<h2>Admin Dashboard</h2>

<h3>Pending Requests</h3>

@if (!Model.Any())
{
    <p>No pending requests.</p>
}
else
{
    <table class=""table"">
        <thead>
            <tr><th>Client</th><th>Name</th><th>Date</th><th>Purpose</th><th>Action</th></tr>
        </thead>
        <tbody>
            @foreach (var request in Model)
            {
                <tr>
                    <td>@request.ClientUser?.Email</td>
                    <td>@request.FullName</td>
                    <td>@request.VisitDate.ToString(""yyyy-MM-dd"")</td>
                    <td>@request.Purpose</td>
                    <td>
                        <form method=""post"" style=""display:inline"">
                            @Html.AntiForgeryToken()
                            <input type=""hidden"" name=""id"" value=""@request.Id"" />
                            <button type=""submit"" formaction=""/Admin/ConfirmRequest"" class=""btn btn-sm btn-success"">Confirm</button>
                        </form>
                        <button type=""button"" class=""btn btn-sm btn-danger"" onclick=""showReturnModal(@request.Id)"">Return</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
