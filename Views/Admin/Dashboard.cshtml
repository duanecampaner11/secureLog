@model List<VisitRequest>

@{
    ViewData["Title"] = "Admin Dashboard";
    var usersWithRoles = ViewBag.UsersWithRoles as List<UserRoleViewModel>;
}

<h2>Admin Dashboard</h2>

<!-- Pending Visit Requests Section -->
<div class="card mb-4">
    <div class="card-header bg-warning">
        <h4>Pending Visit Requests</h4>
    </div>
    <div class="card-body">
        @if (!Model.Any())
        {
            <div class="alert alert-info">No pending requests.</div>
        }
        else
        {
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Client</th>
                        <th>Visitor Name</th>
                        <th>Visit Date</th>
                        <th>Purpose</th>
                        <th>Person to Meet</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var request in Model)
                    {
                        <tr>
                            <td>@request.ClientUser?.Email</td>
                            <td>@request.FullName</td>
                            <td>@request.VisitDate.ToString("yyyy-MM-dd")</td>
                            <td>@request.Purpose</td>
                            <td>@request.PersonToMeet</td>
                            <td>
                                <form method="post" style="display:inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@request.Id" />
                                    <button type="submit" formaction="/Admin/ConfirmRequest" class="btn btn-sm btn-success">Confirm</button>
                                </form>
                                <form method="post" style="display:inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@request.Id" />
                                    <input type="hidden" name="returnReason" value="No reason provided" />
                                    <button type="submit" formaction="/Admin/ReturnRequest" class="btn btn-sm btn-danger">Return</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<!-- User Management Section -->
<div class="card">
    <div class="card-header bg-primary text-white">
        <h4>User Management</h4>
    </div>
    <div class="card-body">
        @if (usersWithRoles == null || !usersWithRoles.Any())
        {
            <p>No users found.</p>
        }
        else
        {
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Username</th>
                        <th>Email</th>
                        <th>Full Name</th>
                        <th>Current Role</th>
                        <th>Change Role</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var userRole in usersWithRoles)
                    {
                        <tr>
                            <td>@userRole.User?.UserName</td>
                            <td>@userRole.User?.Email</td>
                            <td>@userRole.User?.FullName</td>
                            <td>
                                @if (userRole.Roles.Contains("Admin"))
                                {
                                    <span class="badge bg-danger">Admin</span>
                                }
                                else if (userRole.Roles.Contains("Guard"))
                                {
                                    <span class="badge bg-primary">Guard</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Client</span>
                                }
                            </td>
                            <td>
                                <form method="post" asp-action="ChangeUserRole" style="display:inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="userId" value="@userRole.User?.Id" />
                                    <select name="newRole">
                                        <option value="Client">Client</option>
                                        <option value="Guard">Guard</option>
                                        <option value="Admin">Admin</option>
                                    </select>
                                    <button type="submit" class="btn btn-sm btn-warning">Update</button>
                                </form>
                            </td>
                            <td>
                                @if (userRole.User?.UserName != "admin")
                                {
                                    <form method="post" asp-action="DeleteUser" onsubmit="return confirm('Delete this user?')" style="display:inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@userRole.User?.Id" />
                                        <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                    </form>
                                }
                                else
                                {
                                    <span>Protected</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>