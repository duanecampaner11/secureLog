@model List<VisitRequest>

@{
    ViewData["Title"] = "Admin Dashboard";
    var usersWithRoles = ViewBag.UsersWithRoles as List<UserRoleViewModel>;
    var allRoles = ViewBag.AllRoles as List<IdentityRole>;
}

<h2>Admin Dashboard</h2>

<!-- User Management Section -->
<div class="card mb-4">
    <div class="card-header bg-primary text-white">
        <h4>User Management</h4>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-bordered">
                <thead class="table-dark">
                    <tr>
                        <th>Username</th>
                        <th>Email</th>
                        <th>Full Name</th>
                        <th>Company</th>
                        <th>Current Role</th>
                        <th>Change Role</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (usersWithRoles != null)
                    {
                        @foreach (var userRole in usersWithRoles)
                        {
                            <tr>
                                <td>@userRole.User.UserName</strong></td>
                                <td>@userRole.User.Email</strong></td>
                                <td>@userRole.User.FullName</strong></td>
                                <td>@userRole.User.CompanyName</strong></td>
                                <td>
                                    @if (userRole.Roles.Contains("Admin"))
                                    {
                                        <span class="badge bg-danger">Admin</span>
                                    }
                                    else if (userRole.Roles.Contains("Guard"))
                                    {
                                        <span class="badge bg-primary">Guard</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Client</span>
                                    }
                                </td>
                                <td>
                                    <form method="post" asp-action="ChangeUserRole" style="display:inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@userRole.User.Id" />
                                        <select name="newRole" class="form-select form-select-sm" style="display:inline; width:auto;">
                                            <option value="Client">Client</option>
                                            <option value="Guard">Guard</option>
                                            <option value="Admin">Admin</option>
                                        </select>
                                        <button type="submit" class="btn btn-sm btn-warning">Update</button>
                                    </form>
                                </td>
                                <td>
                                    @if (userRole.User.UserName != "admin")
                                    {
                                        <form method="post" asp-action="DeleteUser" onsubmit="return confirm('Delete user @userRole.User.UserName?')" style="display:inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@userRole.User.Id" />
                                            <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Protected</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Pending Visit Requests Section -->
<div class="card">
    <div class="card-header bg-warning">
        <h4>Pending Visit Requests</h4>
    </div>
    <div class="card-body">
        @if (!Model.Any())
        {
            <div class="alert alert-info">No pending requests.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead class="table-dark">
                        <tr>
                            <th>Client</th>
                            <th>Visitor Name</th>
                            <th>Visit Date</th>
                            <th>Purpose</th>
                            <th>Person to Meet</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var request in Model)
                        {
                            <tr>
                                <td>@request.ClientUser?.Email</strong></td>
                                <td>@request.FullName</strong></td>
                                <td>@request.VisitDate.ToString("yyyy-MM-dd")</strong></td>
                                <td>@request.Purpose</strong></td>
                                <td>@request.PersonToMeet</strong></td>
                                <td>
                                    <form method="post" style="display:inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@request.Id" />
                                        <button type="submit" formaction="/Admin/ConfirmRequest" class="btn btn-sm btn-success">Confirm</button>
                                    </form>
                                    
                                    <button type="button" class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#returnModal_@request.Id">Return</button>
                                    
                                    <!-- Return Modal -->
                                    <div class="modal fade" id="returnModal_@request.Id" tabindex="-1">
                                        <div class="modal-dialog">
                                            <div class="modal-content">
                                                <form method="post" action="/Admin/ReturnRequest">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@request.Id" />
                                                    <div class="modal-header">
                                                        <h5>Return Request</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                    </div>
                                                    <div class="modal-body">
                                                        <label>Reason:</label>
                                                        <textarea name="returnReason" class="form-control" required></textarea>
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                        <button type="submit" class="btn btn-danger">Return Request</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
}