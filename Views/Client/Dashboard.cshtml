@model List<VisitRequest>

@{
    ViewData["Title"] = "My Dashboard";
}

<h2>My Visit Requests</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<a href="/Client/CreateRequest" class="btn btn-primary mb-3">+ New Request</a>

@if (!Model.Any())
{
    <div class="alert alert-info">No requests yet.</div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Date</th>
                <th>Purpose</th>
                <th>Person to Meet</th>
                <th>Status</th>
                <th>Confirmation ID</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var request in Model)
            {
                <tr>
                    <td>@(request.VisitDate.HasValue ? request.VisitDate.Value.ToString("yyyy-MM-dd") : "Not set")</strong></td>
                    <td>@request.Purpose</strong></td>
                    <td>@request.PersonToMeet</strong></td>
                    <td><span class="badge bg-warning">@request.Status</span></td>
                    <td>@request.ConfirmationId</strong></td>
                </tr>
            }
        </tbody>
    </table>
}