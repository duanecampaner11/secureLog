@model List<VisitRequest>

@{
    ViewData[""Title""] = ""My Dashboard"";
}

<div class=""container"">
    <h2>My Visit Requests</h2>
    <a href=""/Client/CreateRequest"" class=""btn btn-primary mb-3"">+ New Request</a>
    
    @if (!Model.Any())
    {
        <div class=""alert alert-info"">No requests yet.</div>
    }
    else
    {
        <table class=""table"">
            <thead><tr><th>Date</th><th>Purpose</th><th>Person to Meet</th><th>Status</th><th>Confirmation ID</th></tr></thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td>@r.VisitDate.ToString(""yyyy-MM-dd"")</td>
                        <td>@r.Purpose</td>
                        <td>@r.PersonToMeet</td>
                        <td>@r.Status</td>
                        <td>@r.ConfirmationId</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
